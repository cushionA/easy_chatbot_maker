# Copy to .env and fill in real values. Never commit .env.

# ===== Postgres =====
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

# ===== Backend (Blazor + ASP.NET Core) =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BACKEND_PORT=8080
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=portfolio;Username=portfolio;Password=changeme_dev_only
Embedding__BaseUrl=http://embedding:9000

# ===== Embedding service (FastAPI) =====
EMBEDDING_PORT=9000
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu

# ===== Caddy (本番のみ) =====
DOMAIN=example.com

# ===== Supabase (Auth) — Plan B only =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ===== LLM (BYOK at runtime, not server-side) =====
# Leave empty in production. Tenants supply their own Gemini key.
GEMINI_API_KEY=
