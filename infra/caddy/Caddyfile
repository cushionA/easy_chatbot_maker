# Caddy reverse proxy config. Used on Oracle Cloud VM (Plan A).
# Set DOMAIN env var or replace example.com.
#
# Embedding service (embedding:9000) is intentionally NOT exposed here:
# only the backend on the internal Docker network is allowed to call it,
# so all external traffic must go through Blazor's auth/authorization.
{$DOMAIN:example.com} {
    encode zstd gzip

    handle {
        reverse_proxy backend:8080 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
